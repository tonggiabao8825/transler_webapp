{
  "name": "transler-api",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "dev": "tsx watch --env-file=../.env src/main.ts",
    "start": "node dist/main.js",
    "admin:create": "tsx --env-file=../.env src/admin-bootstrap.ts",
    "format": "prettier --write src",
    "test": "npm run build && uv --directory ../backend run pytest -m 'not translation' -q"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.3",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "argon2": "^0.45.1",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "redis": "^6.3.0",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
